+class TestTickerCleanup(TestCase):
+    def test_response_unwind_restores_ticker(self):
+        from ragger.error import ExceptionRAPDU
+        for method, args in [
+            ('navigate_and_compare', (None, None, [])),
+            ('navigate_until_text_and_compare', (NavInsID.RIGHT_CLICK, [NavInsID.BOTH_CLICK], 'Approve')),
+        ]:
+            with self.subTest(method=method):
+                backend = MagicMock()
+                navigator = Navigator.__new__(Navigator)
+                navigator._backend = backend
+                navigator._run_instruction = MagicMock(side_effect=ExceptionRAPDU(0xE000, b'proof'))
+                with self.assertRaises(ExceptionRAPDU):
+                    getattr(navigator, method)(*args)
+                backend.pause_ticker.assert_called_once_with()
+                backend.resume_ticker.assert_called_once_with()
