leanprover/lean4:v4.35.0
{"version": "1.3.0",
 "packagesDir": ".lake/packages",
 "packages":
 [{"url": "https://github.com/Th0rgal/lean-sys.git",
   "type": "git",
   "subDir": null,
   "scope": "",
   "rev": "077775ba387f1eeb2976cb8763b4633b8d5ce313",
   "name": "«lean-sys»",
   "manifestFile": "lake-manifest.json",
   "inputRev": "077775ba387f1eeb2976cb8763b4633b8d5ce313",
   "inherited": false,
   "configFile": "lakefile.lean"}],
 "name": "«turbo-lean-proofs»",
 "lakeDir": ".lake",
 "fixedToolchain": false}
Incremental two-level CAS build with automatic multi-agent Singleflight coalescing

Usage: turbo-lean build [OPTIONS] [TARGETS]...

Arguments:
  [TARGETS]...  Optional Lake targets to build

Options:
      --cache-dir <CACHE_DIR>          Optional custom CAS & SQLite directory (defaults to $TURBO_LEAN_HOME or ~/.cache/turbo-lean)
      --project-dir <PROJECT_DIR>      Project root directory [default: .]
      --json                           Output JSON results for agent/CI consumption
      --trust-domain <TRUST_DOMAIN>    Trust domain ('trusted' or 'untrusted:<id>') [default: trusted]
      --max-memory-mb <MAX_MEMORY_MB>  Optional memory budget cap in MiB (sets TURBO_LEAN_MAX_MEMORY_MB for hardware-adaptive governor)
      --pin-level <PIN_LEVEL>          Pin built artifacts in CAS (0=normal, 1=main_branch, 2=toolchain) [default: 0]
      --seed-shards                    Seed TheoremProofCAS with all verified theorem shards after build completes
  -h, --help                           Print help
name: turbo-lean CI (Self-Hosted CAS & Proof Verification)

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

env:
  CARGO_TERM_COLOR: always
  LEAN_NUM_THREADS: "4"
  # Axiom-policy audit tests change process-wide environment variables.
  RUST_TEST_THREADS: "1"
  TURBO_LEAN_HOME: ${{ github.workspace }}/.turbo-cache

jobs:
  impact:
    name: Fast inventory and impact gates
    runs-on: ubuntu-latest
    outputs:
      run_lean_build: ${{ steps.plan.outputs.run_lean_build }}
      impact_digest: ${{ steps.plan.outputs.impact_digest }}
      inputs_unchanged: ${{ steps.plan.outputs.inputs_unchanged }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          fetch-depth: 0
          persist-credentials: false
      - run: |
          python3 scripts/ci_impact_plan.py --self-test
          python3 scripts/sync_docs_inventory.py --check
          python3 scripts/emitter_mutants.py --unit-tests
          python3 scripts/run_llvm_lli_diff.py --self-test
          python3 scripts/run_alive2_tv.py --self-test
          python3 scripts/check_lean_mlir_bridge_sync.py --self-test
          python3 scripts/check_lean_mlir_bridge_sync.py
          python3 scripts/run_target_ir_fuzz.py --self-test
          python3 sdk/accelerator-template/validate.py
      - id: plan
        env:
          BASE: ${{ github.event.pull_request.base.sha || github.event.before || github.sha }}
        run: |
          if [ "$BASE" = "0000000000000000000000000000000000000000" ]; then BASE=HEAD; fi
          python3 scripts/ci_impact_plan.py --base "$BASE"

  verify:
    needs: impact
    if: needs.impact.outputs.run_lean_build == 'true'
    name: Build turbo-lean & Self-Verify Lean 4 Proofs
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable

      - name: Provision bubblewrap sandbox for untrusted PR verification
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends bubblewrap
          if [ -f /proc/sys/kernel/apparmor_restrict_unprivileged_userns ]; then
            sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
          fi
          bwrap --unshare-all --new-session --die-with-parent --clearenv --setenv PATH /usr/bin:/bin --dev /dev --proc /proc --tmpfs /tmp --ro-bind /usr /usr --ro-bind /bin /bin --ro-bind /lib /lib --ro-bind /lib64 /lib64 --ro-bind /etc /etc true

      - name: Cache Lean toolchain, Cargo registry, and build artifacts
        uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
        with:
          path: |
            ~/.elan
            ~/.cargo/registry
            ~/.cargo/git
            target
            lean/.lake/build
          key: ${{ runner.os }}-ci-cargo-lean-${{ needs.impact.outputs.impact_digest }}
          restore-keys: |
            ${{ runner.os }}-ci-cargo-lean-
            ${{ runner.os }}-roadmap-cargo-lean-

      - name: Setup Lean 4 toolchain
        run: |
          set -euo pipefail
          TOOLCHAIN="$(tr -d '[:space:]' < lean/lean-toolchain)"
          BACKOFFS=(2 4 8 16 20)
          READY=0
          for ATTEMPT in 1 2 3 4 5 6; do
            if { [ -x "$HOME/.elan/bin/elan" ] || { curl --retry 5 --retry-all-errors -sSf https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh | sh -s -- -y --default-toolchain none; }; } \
              && [ -x "$HOME/.elan/bin/elan" ] \
              && { "$HOME/.elan/bin/elan" toolchain list | grep -Fq "$TOOLCHAIN" || "$HOME/.elan/bin/elan" toolchain install "$TOOLCHAIN"; }; then
              READY=1
              break
            fi
            rm -rf "$HOME/.elan/tmp"
            if [ "$ATTEMPT" -lt 6 ]; then
              DELAY="${BACKOFFS[$((ATTEMPT - 1))]}"
              echo "elan setup attempt ${ATTEMPT}/6 failed; retrying in ${DELAY}s..." >&2
              sleep "$DELAY"
            fi
          done
          if [ "$READY" -ne 1 ]; then
            echo "elan setup failed after 6 attempts for $TOOLCHAIN" >&2
            exit 1
          fi
          "$HOME/.elan/bin/elan" default "$TOOLCHAIN"
          echo "$HOME/.elan/bin" >> "$GITHUB_PATH"
          echo "${GITHUB_WORKSPACE}/lean/.lake/build/bin" >> "$GITHUB_PATH"
          (cd lean && "$HOME/.elan/bin/lean" --version)

      - name: Restore turbo-lean portable CAS bundle (.tlpack)
        uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
        with:
          path: .turbo-pack
          key: turbo-lean-cas-${{ hashFiles('lean/lean-toolchain', 'lean/**/*.lean') }}
