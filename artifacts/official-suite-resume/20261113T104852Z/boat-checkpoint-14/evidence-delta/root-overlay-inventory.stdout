Fri Nov 13 12:23:24 UTC 2026
[workspace]
resolver = "2"
members = ["app-sdk", "client-sdk", "ecalls", "macros", "common", "cargo-vnd", "riscv-arch-tests"]

[workspace.package]
edition = "2024"
[package]
name = "cargo-vnd"
version = "0.1.0"
edition.workspace = true

[[bin]]
name = "cargo-vnd"
path = "src/main.rs"

[dependencies]
anyhow = "1.0.98"
clap = { version = "4.5.38", features = ["derive"] }
common = { path = "../common", features = ["serde_json"] }
client_sdk = { path = "../client-sdk", package="vanadium-client-sdk", features=["cargo_toml", "transport", "target_all"], default-features = false }
which = "7.0.3"
cargo-generate = "0.23.8"
# rhai_codegen 3.2.0 regressed: the deprecated #[export_fn]/#[export_module] macros
# now hardcode `::rhai` as the generated-code root path. When rhai uses these macros
# in its own source, `::rhai` cannot be resolved (you cannot reference your own crate
# by its external name), breaking compilation on Rust >=1.94. Pin to <3.2.
rhai_codegen = "=3.1.0"
# auth-git2 0.5.8 has a broken version requirement `>0.14, <21.0` (intended as `<0.21`)
# that allows git2 0.21 but uses APIs only present in earlier versions. Pin git2 to
# 0.20 here to keep the resolver on a compatible version.
git2 = { version = "0.20", default-features = false }
tokio = { version = "1.38.1", features = ["io-util", "macros", "net", "rt", "rt-multi-thread", "sync"] }
env_logger = "0.11"
name = "cargo-vnd"
version = "0.1.0"
dependencies = [
 "anyhow",
 "cargo-generate",
 "clap",
 "common",
 "env_logger",
 "git2",
 "tokio",
 "vanadium-client-sdk",
 "which",
]

[[package]]
name = "cargo_toml"
version = "0.22.1"
source = "registry+https://github.com/rust-lang/crates.io-index"
checksum = "02260d489095346e5cafd04dea8e8cb54d1d74fcd759022a9b72986ebe9a1257"
dependencies = [
 "serde",
 "toml 0.8.23",
]

[[package]]
name = "cc"
version = "1.2.21"
source = "registry+https://github.com/rust-lang/crates.io-index"
checksum = "8691782945451c1c383942c4874dbe63814f61cb57ef773cda2972682b7bb3c0"
dependencies = [
 "jobserver",
 "libc",
 "shlex",
]

[[package]]
stable-x86_64-unknown-linux-gnu (active, default)
cargo 1.100.0 (3acc79c0c 2026-11-05)
Available unstable (nightly-only) flags:

    -Z allow-features              Allow *only* the listed unstable features
    -Z embed-metadata              Avoid embedding metadata in library artifacts
    -Z any-build-script-metadata   Allow any build script to specify env vars via cargo::metadata=key=value
    -Z avoid-dev-deps              Avoid installing dev-dependencies if possible
    -Z binary-dep-depinfo          Track changes to dependency artifacts
    -Z bindeps                     Allow Cargo packages to depend on bin, cdylib, and staticlib crates, and use the artifacts built by those crates
    -Z build-analysis              Record and persist build metrics across runs, with commands to query past builds.
    -Z build-dir-new-layout        Use the new build-dir filesystem layout
    -Z build-std                   Enable Cargo to compile the standard library itself as part of a crate graph compilation
    -Z build-std-features          Configure features enabled for the standard library itself when building the standard library
    -Z checksum-freshness          Use a checksum to determine if output is fresh rather than filesystem mtime
    -Z codegen-backend             Enable the `codegen-backend` option in profiles in .cargo/config.toml file
    -Z direct-minimal-versions     Resolve minimal dependency versions instead of maximum (direct dependencies only)
    -Z dual-proc-macros            Build proc-macros for both the host and the target
    -Z feature-unification         Enable new feature unification modes in workspaces
    -Z fine-grain-locking          Use fine grain locking instead of locking the entire build cache
    -Z fix-edition                 Permanently unstable edition migration helper
    -Z gc                          Track cache usage and "garbage collect" unused files
    -Z git                         Enable support for shallow git fetch operations
    -Z gitoxide                    Use gitoxide for the given git interactions, or all of them if no argument is given
    -Z hint-msrv                   Enable passing `package.rust-version` to rustc for lints
    -Z host-config                 Enable the `[host]` section in the .cargo/config.toml file
    -Z json-target-spec            Enable `.json` target spec files
    -Z minimal-versions            Resolve minimal dependency versions instead of maximum
    -Z msrv-policy                 Enable rust-version aware policy within cargo
    -Z mtime-on-use                Configure Cargo to update the mtime of used files
    -Z no-index-update             Do not update the registry index even if the cache is outdated
    -Z panic-abort-tests           Enable support to run tests with -Cpanic=abort
    -Z panic-immediate-abort       Enable setting `panic = "immediate-abort"` in profiles
    -Z prerelease                  Allow selecting pre-release versions with `update --precise`
    -Z profile-hint-mostly-unused  Enable the `hint-mostly-unused` setting in profiles to mark a crate as mostly unused.
    -Z profile-rustflags           Enable the `rustflags` option in profiles in .cargo/config.toml file
    -Z public-dependency           Respect a dependency's `public` field in Cargo.toml to control public/private dependencies
    -Z publish-timeout             Enable the `publish.timeout` key in .cargo/config.toml file
    -Z root-dir                    Set the root directory relative to which paths are printed (defaults to workspace root)
    -Z rustc-unicode               Enable `rustc`'s unicode error format in Cargo's error messages
    -Z rustdoc-depinfo             Use dep-info files in rustdoc rebuild detection
    -Z rustdoc-map                 Allow passing external documentation mappings to rustdoc
    -Z rustdoc-mergeable-info      Use rustdoc mergeable cross-crate-info files
    -Z rustdoc-scrape-examples     Allows Rustdoc to scrape code examples from reverse-dependencies
    -Z sbom                        Enable the `sbom` option in build config in .cargo/config.toml file
    -Z script                      Enable support for single-file, `.rs` packages
    -Z section-timings             Enable support for extended compilation sections in --timings output
    -Z target-applies-to-host      Enable the `target-applies-to-host` key in the .cargo/config.toml file
    -Z trim-paths                  Enable the `trim-paths` option in profiles
    -Z unstable-options            Allow the usage of unstable options

Run with `cargo -Z [FLAG] [COMMAND]`

Unstable flags are only available on the nightly channel of Cargo, but this is the `stable` channel.
See https://doc.rust-lang.org/book/appendix-07-nightly-rust.html for more information about Rust release channels.

